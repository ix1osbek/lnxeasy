# Copy this file to .env and change the values you need.

# Address the server listens on.
# 127.0.0.1 = only this machine, 0.0.0.0 = all network interfaces.
HOST=127.0.0.1

# Port the server listens on (0-65535).
PORT=4321

# File that holds the admin account (username and password hash).
# Create it with: npm run passwd
AUTH_FILE=data/auth.json

# HTTPS certificate and private key. Both are required when HOST is not 127.0.0.1.
# TLS_CERT_FILE=/etc/lnxeasy/tls/cert.pem
# TLS_KEY_FILE=/etc/lnxeasy/tls/key.pem

# Only behind a reverse proxy that adds HTTPS itself.
# ALLOW_INSECURE_HTTP=yes

# Only these addresses or ranges may connect. Empty = everyone.
# ALLOWED_IPS=203.0.113.7,10.8.0.0/16
